Solver.Loop.begin_step = 0
Solver.Loop.end_step = 1000
Solver.Loop.dt = 1e-2
Solver.Mesh.Nx = 256
Solver.Mesh.Ny = 256
Solver.Mesh.dr = 1.0
# Solver.Mesh.BoundaryCondition : 0 - FIXED , 1 - PERIODIC , 2 - ZEROFLUX , 3 - OPEN 
Solver.Mesh.BoundaryCondition.x_up = 1
Solver.Mesh.BoundaryCondition.x_down = 1
Solver.Mesh.BoundaryCondition.y_up = 1
Solver.Mesh.BoundaryCondition.y_down = 1
# Solver.Mesh.PCT = ( phi_number, con_number, is_temperature_on ) 
Solver.Mesh.PCT = (3,0,false)
# Solver.Mesh.EPF = ( is_mechanical_field_on, is_fluid_field_on ) 
Solver.Mesh.EPF = (true,false)
# .matrix_phi = ( phi_index, phi_value ) 
Preprocess.Microstructure.matrix_phi = (0,1)
Preprocess.Microstructure.geometry_layer_number = 2
# .property = (phi_index, geometry_type, rotation_gauge, reverse_region) 
#              geometry_type  : 0 - None, 1 - Ellipsoid, 2 - Polyhedron, 3 - Geo_SegmentedCylinder, 4 - RectangularCuboid 
#              rotation_gauge : 0 - XYX, 1 - XZX, 2 - YXY, 3 - YZY, 4  - ZXZ, 5  - ZYZ 
#                               6 - XYZ, 7 - XZY, 8 - YXZ, 9 - YZX, 10 - ZXY, 11 - ZYX 
#  The compute box of the simulation mesh is [( 1 , 1 , 1 ) , ( 128 , 128 , 1 )] 
#  The boundary of the simulation mesh is x = 0 and 129 , y = 0 and 129 , z = 0 and 2 
Preprocess.Microstructure.geometry_layer_0.property = (1,1,1,false)
# .ellipsoid = [(core_x,core_y,core_z),(radius_x,radius_y,radius_z),(rotation_angle_1,rotation_angle_2,rotation_angle_3)] 
Preprocess.Microstructure.geometry_layer_0.ellipsoid = [(129.5,129.5,1),(110,110,110),(0,0,0)]
Preprocess.Microstructure.geometry_layer_0.phi = 1.0
Preprocess.Microstructure.geometry_layer_0.is_normalized = true
Preprocess.Microstructure.geometry_layer_1.property = (2,1,1,false)
# .ellipsoid = [(core_x,core_y,core_z),(radius_x,radius_y,radius_z),(rotation_angle_1,rotation_angle_2,rotation_angle_3)] 
Preprocess.Microstructure.geometry_layer_1.ellipsoid = [(129.5,129.5,1),(90,90,90),(0,0,0)]
Preprocess.Microstructure.geometry_layer_1.phi = 1.0
Preprocess.Microstructure.geometry_layer_1.is_normalized = true
========================================================================================= 
# SimulationModels.model =  0 - None 
#                           1 - Grain Grows Spinodal , PCT = (N,1,false) 
#                           2 - Data Driven Complex Model , PCT = (N > 0, K, true/false) 
SimulationModels.model = 2
# Model.PhiProperties = {[(phi_name_0),(phi_index_0, phi_index_1, ... )],  ... } 
Model.PhiProperties = {[(PHI_0),(0)],[(PHI_1),(1)],[(PHI_2),(2)]}
# Model.DDC.difference_method : 0 - SEVEN_POINT , 1 - NINETEEN_POINT 
Model.DDC.difference_method = 0
Model.DDC.Phi.is_normalize = true
Model.DDC.Phi.PairWiseAcc.container_size = 2
# Model.DDC.Phi.IntMobility.const  = Lij_value 
#                          .matrix = [(phi_index_i, phi_index_j, Lij_value), ... ] 
#                          .block  = [(phi_index_begin, phi_index_end, Lij_value), ... ] 
Model.DDC.Phi.IntMobility.const = 1.0
# Model.DDC.Phi.InterfaceEnergy.int_gradient : 0 - Steinbach_1996 , 1 - Steinbach_1999 , 2 - Steinbach_G2009 
Model.DDC.Phi.InterfaceEnergy.int_gradient = 0
# Model.DDC.Phi.InterfaceEnergy.int_potential : 0 - Nestler_Well , 1 - Nestler_Obstacle , 2 - Steinbach_P2009 
Model.DDC.Phi.InterfaceEnergy.int_potential = 1
Model.DDC.Phi.InterfaceEnergy.int_width = 4.0
# Model.DDC.Phi.InterfaceEnergy.const  = xi_ab 
#                              .matrix = [(phi_a_name, phi_b_name, xi_ab), ...] 
Model.DDC.Phi.InterfaceEnergy.const = 1.0
========================================================================================= 
# Parameters in SolidMechanics module : 
# Postprocess.SolidMechanics.calculate_step = ( simulation_step , ... ) 
#                                           = empty - solver calculated every step , otherwise - solver calculated at the defined step 
Postprocess.SolidMechanics.calculate_step = (1000)
# Postprocess.SolidMechanics.solid_phase = ( phase_name_0, ... ) 
Postprocess.SolidMechanics.solid_phase = (PHI_1,PHI_2)
# Postprocess.SolidMechanics.Stiffness.PhaseName  = [(C11,C12,C13,C14,C15,C16),\\ 
#                                                    (C21,C22,C23,C24,C25,C26),\\ 
#                                                    (C31,C32,C33,C34,C35,C36),\\ 
#                                                    (C41,C42,C43,C44,C45,C46),\\ 
#                                                    (C51,C52,C53,C54,C55,C56),\\ 
#                                                    (C61,C62,C63,C64,C65,C66)] 
# Postprocess.SolidMechanics.EigenStrain.PhaseName = (E11,E22,E33,2E23,2E13,2E12) 
Postprocess.SolidMechanics.Stiffness.PHI_1 = [(C11,C12,C12,0,0,0),\\
                                              (C12,C11,C12,0,0,0),\\
                                              (C12,C12,C11,0,0,0),\\
                                              (0,0,0,Gm,0,0),\\
                                              (0,0,0,0,Gm,0),\\
                                              (0,0,0,0,0,Gm)]
Postprocess.SolidMechanics.EigenStrain.PHI_1 = (0.01,0.01,0,0,0,0)
Postprocess.SolidMechanics.Stiffness.PHI_2 = [(C11,C12,C12,0,0,0),\\
                                              (C12,C11,C12,0,0,0),\\
                                              (C12,C12,C11,0,0,0),\\
                                              (0,0,0,Gm,0,0),\\
                                              (0,0,0,0,Gm,0),\\
                                              (0,0,0,0,0,Gm)]
Postprocess.SolidMechanics.EigenStrain.PHI_2 = (0,0,0,0,0,0)
# Postprocess.SolidMechanics.Elasticity.momentum_balance = 0 - None , 1 - Implicit (Ingo Steinbach) , 2 - Implicit (Armen G. Khachaturyan) 
Postprocess.SolidMechanics.Elasticity.momentum_balance = 2
Postprocess.SolidMechanics.Elasticity.VisualStrain.L_ijkl = 1e-4
# Postprocess.SolidMechanics.Elasticity.SolverRestartInLoop.steps = 1
# Postprocess.SolidMechanics.Elasticity.fix_boundary.type = (BC_X, BC_Y, BC_Z) , 0 - Average , 1 - Strain , 2 - Stress 
Postprocess.SolidMechanics.Elasticity.fix_boundary.type = (0,0,0)
Postprocess.SolidMechanics.Elasticity.write_displacement_field = true
Postprocess.SolidMechanics.Elasticity.max_iteration_steps = 5000
Postprocess.SolidMechanics.Elasticity.debug = true
Postprocess.SolidMechanics.Elasticity.strain_accuracy = 0.00001
========================================================================================= 
Solver.Output.LOG.pct_loop_step = 100
Solver.Output.LOG.pct_statistic_step = 1000
Solver.Output.VTS.phi_index = TRUE
Solver.Output.VTS.mech_stress = TRUE
Solver.Output.VTS.mech_strain = TRUE
Solver.Output.VTS.mech_non_elastic_strain = TRUE
Solver.Output.VTS.mech_J1 = TRUE
Solver.Output.VTS.mech_vMises = TRUE
Solver.Output.VTS.frequence = 1000
Solver.Output.VTS.with_boundary = TRUE
========================================================================================= 
Define.Var = Gm,100
Define.Var = v,0.3
Define.Var = Az,3.0
Define.Func = C12@{[v*Gm/(1-2*v)]}@
Define.Func = C11@{[(2*Gm/Az+C12<0>)]}@